# Local-only secrets template for `npx wrangler dev`
# Copy to `.dev.vars` (never commit `.dev.vars` to Git!)
# In production on Cloudflare, set these with `npx wrangler secret put <KEY>`

ADMIN_EMAIL=gopal.arora@nexafundadvisor.com
ADMIN_NAME=Mr. Gopal Arora
# Generate hash with: npm run hash:password
ADMIN_PASSWORD_HASH=
# Fallback plain password for local testing only (omit in production):
# ADMIN_PASSWORD=change-this-strong-password-before-deploy

# Minimum 32 random characters for HMAC-SHA256 session cookie signing:
SESSION_SECRET=replace-with-a-long-random-64-char-secret-string-for-production

# Google Sheets Service Account credentials:
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep \n escaped on one line:
GOOGLE_PRIVATE_KEY=

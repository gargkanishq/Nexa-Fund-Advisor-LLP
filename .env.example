# ==============================================================================
# Nexa Fund Advisor LLP — Environment Configuration
# Copy this file to .env and fill in the values before running in production.
# NEVER commit .env or Google Private Keys to version control.
# ==============================================================================

# Server & Site
PORT=5000
# Leave NODE_ENV unset locally during builds; set NODE_ENV=production on your live server.
# NODE_ENV=production
SITE_URL=https://nexafundadvisor.com

# Admin Authentication for Nexa Insights Blog CMS (/admin)
# Set ADMIN_EMAIL and either ADMIN_PASSWORD_HASH (recommended) or ADMIN_PASSWORD.
# Generate a password hash anytime using:
#   node -e "import('./server/utils/auth.js').then(m => console.log(m.hashPassword('YourStrongPassword')))"
ADMIN_EMAIL=gopal.arora@nexafundadvisor.com
ADMIN_NAME=Mr. Gopal Arora
ADMIN_PASSWORD=change-this-strong-password-before-deploy
# ADMIN_PASSWORD_HASH=scrypt$...

# Long random secret (minimum 32 characters) for signing HttpOnly admin session cookies
SESSION_SECRET=replace-with-a-long-random-64-char-secret-string-for-production

# Google Sheets Lead Management Integration
# Create a Service Account in Google Cloud Console, enable Google Sheets API,
# share your Google Sheet with the Service Account email (Editor access),
# and paste the credentials below.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Replace literal newlines in your JSON private_key with \n when storing in one line:
GOOGLE_PRIVATE_KEY=

# Local Development Lead Storage Fallback
# Set to "true" ONLY during local testing when Google Sheets is not yet configured.
# When "false" (recommended in production), submissions require live Google Sheets credentials.
ALLOW_LOCAL_LEAD_FALLBACK=false
